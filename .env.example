# Copie este arquivo para ".env" (na raiz do projeto) e ajuste os valores.
# Todas as variáveis são opcionais — sem nenhuma configurada, o app roda
# 100% local, sem webhook, sem Sheets e sem proteção por API key.

# URL do webhook do n8n. Se preenchido, ao final de cada varredura os leads
# encontrados são enviados automaticamente em um POST (JSON) pra essa URL.
N8N_WEBHOOK_URL=

# Caminho pro arquivo JSON da service account do Google (pra exportar leads
# direto pro Google Sheets). Veja o passo a passo no README.md.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Se preenchida, a varredura usa a Google Places API (New) oficial em vez de
# raspar o Maps com Playwright — mais confiável, mas cobra por consulta acima
# da cota grátis mensal. Deixe em branco pra continuar usando o scraper
# (padrão). Passo a passo e estimativa de custo no README.md.
GOOGLE_PLACES_API_KEY=

# Chave pra proteger os endpoints da API com o header "X-API-Key".
# Deixe em branco pra uso 100% local sem senha (recomendado se só você usa a máquina).
API_KEY=

# true = Chromium roda invisível (headless). false = abre a janela do navegador,
# útil pra debugar se a raspagem estiver falhando ou parecendo travada.
HEADLESS=true

# Atraso aleatório (em segundos) entre ações do scraper, pra parecer mais
# humano e reduzir o risco de bloqueio temporário pelo Google.
SCRAPE_DELAY_MIN=1.2
SCRAPE_DELAY_MAX=3.0

# Limite padrão de resultados por busca (se o campo "Máx. resultados" do
# formulário não for preenchido) e o teto máximo permitido por busca.
MAX_RESULTS_DEFAULT=60
MAX_RESULTS_HARD_CAP=200

# Quantas tentativas extras por estabelecimento antes de desistir dele.
MAX_RETRIES_PER_LISTING=2

# Quantas falhas seguidas (já contando as tentativas extras) pausam a
# varredura inteira. A varredura fica com status "partial" e dá pra retomar
# depois (menu "Varreduras anteriores" -> botão "Retomar").
CIRCUIT_BREAKER_THRESHOLD=5

# Caminho do banco SQLite. Deixe em branco para usar o padrão (data/prospector.db).
DB_PATH=
